{
	"$schema": "./node_modules/@yuu1111/quality-check/schema.json",
	"failOnWarnings": true,
	"biome": true,
	"oxlint": true,
	"oxfmt": true,
	"typecheck": true,
	"knip": true,
	"code": true,
	"comment": {
		"rules": {
			"cramped-comment": "on",
			"japanese-period": "on"
		}
	},
	"markdown": {
		"rules": {
			"preset": "all",
			"first-line-heading": "off",
			"list-blank-lines": "off"
		}
	},
	"tsdoc": {
		"rules": {
			"preset": "all",
			"style": {
				"options": {
					"scope": "documented"
				}
			}
		}
	}
}
