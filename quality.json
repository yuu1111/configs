{
	"$schema": "./node_modules/@yuu1111/quality-check/schema.json",
	"failOnWarnings": true,
	"biome": {
		"enabled": true
	},
	"typecheck": {
		"enabled": true
	},
	"knip": {
		"enabled": true
	},
	"code-style-check": {
		"enabled": true
	},
	"comment-check": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"shape": {
				"cramped-comment": "on"
			},
			"content": {
				"japanese-period": "on"
			}
		}
	},
	"document-style-check": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"structure": {
				"first-line-heading": "off"
			}
		}
	},
	"tsdoc-check": {
		"enabled": true,
		"rules": {
			"preset": "all"
		},
		"styleScope": "documented"
	}
}
