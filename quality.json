{
	"$schema": "./node_modules/@yuu1111/quality-check/schema.json",
	"failOnWarnings": true,
	"biome": true,
	"typecheck": true,
	"knip": true,
	"code-style-check": true,
	"comment-check": {
		"rules": {
			"cramped-comment": "on",
			"japanese-period": "on"
		}
	},
	"document-style-check": {
		"rules": {
			"preset": "all",
			"first-line-heading": "off"
		}
	},
	"tsdoc-check": {
		"rules": {
			"preset": "all",
			"style": {
				"options": {
					"scope": "documented"
				}
			}
		}
	}
}
