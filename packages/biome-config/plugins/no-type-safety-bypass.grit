engine biome(1.0)
language js(typescript)

or {
	`$value as unknown as $type` as $match where {
		register_diagnostic(span=$match, message="Do not bypass type safety with a chained assertion", severity="warn")
	},
	`$value as Record<string, unknown>` as $match where {
		register_diagnostic(span=$match, message="Validate the object shape instead of asserting a generic dictionary", severity="warn")
	},
	`JSON.parse($value) as $type` as $match where {
		not $type <: `unknown`,
		register_diagnostic(span=$match, message="Validate parsed JSON before asserting its type", severity="warn")
	},
	`$response.json() as Promise<$type>` as $match where {
		register_diagnostic(span=$match, message="Validate the JSON response before asserting its type", severity="warn")
	},
	`(await $response.json()) as $type` as $match where {
		not $type <: `unknown`,
		register_diagnostic(span=$match, message="Validate the JSON response before asserting its type", severity="warn")
	},
	`Reflect.get($object, $property)` as $match where {
		$property <: JsStringLiteralExpression(),
		register_diagnostic(span=$match, message="Use direct property access when the property name is static", severity="warn")
	},
	`Reflect.apply($function, undefined, $arguments)` as $match where {
		$arguments <: JsArrayExpression(),
		register_diagnostic(span=$match, message="Call the function directly when no receiver is required", severity="warn")
	}
}
