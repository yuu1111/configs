engine biome(1.0)
language js(typescript)

or {
	`$test($name, () => {}, $...)` as $match where { $test <: r"^(?:test|it)$" },
	`$test($name, async () => {}, $...)` as $match where {
		$test <: r"^(?:test|it)$"
	},
	`$test($name, function () {}, $...)` as $match where {
		$test <: r"^(?:test|it)$"
	},
	`$test($name, async function () {}, $...)` as $match where {
		$test <: r"^(?:test|it)$"
	},
	`expect($value).$matcher($value)` as $match where {
		$value <: JsIdentifierExpression(),
		$matcher <: r"^(?:toBe|toEqual|toStrictEqual)$"
	},
	`expect($value).$matcher($value)` as $match where {
		$value <: JsStringLiteralExpression(),
		$matcher <: r"^(?:toBe|toEqual|toStrictEqual)$"
	},
	`expect($value).$matcher($value)` as $match where {
		$value <: JsNumberLiteralExpression(),
		$matcher <: r"^(?:toBe|toEqual|toStrictEqual)$"
	},
	`expect($value).$matcher($value)` as $match where {
		$value <: JsBooleanLiteralExpression(),
		$matcher <: r"^(?:toBe|toEqual|toStrictEqual)$"
	},
	`expect($value).$matcher($value)` as $match where {
		$value <: JsNullLiteralExpression(),
		$matcher <: r"^(?:toBe|toEqual|toStrictEqual)$"
	}
} where {
	register_diagnostic(span=$match, message="Remove empty or tautological tests", severity="warn")
}
