{
	"name": "@yuu1111/document-style-check",
	"version": "0.3.3",
	"description": "Shared document style checker and review ledger",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/configs.git",
		"directory": "packages/document-style-check"
	},
	"type": "module",
	"bin": {
		"document-style-check": "bin/cli.js"
	},
	"exports": {
		".": "./dist/scan.js",
		"./audit": "./dist/audit.js"
	},
	"files": [
		"README.ja.md",
		"bin",
		"dist"
	],
	"scripts": {
		"build": "bun build src/cli.ts src/scan.ts src/audit.ts --target=bun --outdir=dist"
	},
	"keywords": [
		"documentation",
		"lint",
		"markdown",
		"style"
	],
	"devDependencies": {
		"@yuu1111/shared": "workspace:*"
	}
}
