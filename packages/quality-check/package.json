{
	"name": "@yuu1111/quality-check",
	"version": "7.0.2",
	"description": "Integrated quality check runner with the check engines built in",
	"homepage": "https://yuu1111.github.io/configs/packages/quality-check/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/configs.git",
		"directory": "packages/quality-check"
	},
	"type": "module",
	"bin": {
		"quality-check": "bin/cli.js"
	},
	"exports": {
		"./schema.json": "./schema.json"
	},
	"files": [
		"README.ja.md",
		"bin",
		"dist",
		"schema.json"
	],
	"scripts": {
		"build": "bun build src/cli.ts --target=bun --outdir=dist && bun run scripts/generate-schema.ts"
	},
	"keywords": [
		"quality",
		"lint"
	],
	"devDependencies": {
		"@babel/parser": "^8.0.7",
		"@babel/types": "^8.0.6",
		"@microsoft/tsdoc": "^0.17.1",
		"mdast-util-from-markdown": "^2.0.2"
	}
}
