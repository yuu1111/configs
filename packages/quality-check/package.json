{
	"name": "@yuu1111/quality-check",
	"version": "0.7.0",
	"description": "Integrated quality check runner",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/configs.git",
		"directory": "packages/quality-check"
	},
	"type": "module",
	"bin": {
		"quality-check": "bin/cli.js"
	},
	"exports": {
		".": "./src/config.ts",
		"./engines": "./src/engines.ts"
	},
	"files": [
		"README.ja.md",
		"bin",
		"src/config.ts",
		"src/engines.ts",
		"dist"
	],
	"scripts": {
		"build": "bun build src/cli.ts --target=bun --outdir=dist"
	},
	"keywords": [
		"quality",
		"lint"
	],
	"devDependencies": {
		"@yuu1111/shared": "workspace:*"
	}
}
