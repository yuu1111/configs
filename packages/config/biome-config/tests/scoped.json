{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"linter": {
		"rules": {
			"recommended": false
		}
	},
	"plugins": [
		{
			"path": "../plugins/scoped/no-adapter-import.grit",
			"includes": [
				"**/scoped-*.ts"
			]
		},
		{
			"path": "../plugins/scoped/no-direct-response.grit",
			"includes": [
				"**/response-*.ts"
			]
		}
	]
}
