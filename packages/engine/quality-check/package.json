{
	"name": "@yuu1111/quality-check",
	"version": "4.2.0",
	"description": "Integrated quality check runner with the check engines built in",
	"homepage": "https://yuu1111.github.io/configs/packages/engine/quality-check/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/configs.git",
		"directory": "packages/engine/quality-check"
	},
	"type": "module",
	"bin": {
		"quality-check": "bin/cli.js"
	},
	"exports": {
		"./schema.json": "./schema.json"
	},
	"files": [
		"README.ja.md",
		"bin",
		"dist",
		"schema.json"
	],
	"scripts": {
		"build": "bun build src/cli.ts --target=bun --outdir=dist && bun run src/generate-schema.ts"
	},
	"keywords": [
		"quality",
		"lint"
	],
	"devDependencies": {
		"@yuu1111/code-style-check": "workspace:*",
		"@yuu1111/comment-check": "workspace:*",
		"@yuu1111/document-style-check": "workspace:*",
		"@yuu1111/shared": "workspace:*",
		"@yuu1111/tsdoc-check": "workspace:*"
	}
}
