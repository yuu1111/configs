{
	"name": "@yuu1111/comment-check",
	"version": "2.2.2",
	"description": "Shared comment and suppression checker",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/configs.git",
		"directory": "packages/engine/comment-check"
	},
	"type": "module",
	"bin": {
		"comment-check": "bin/cli.js"
	},
	"exports": {
		".": "./dist/scan.js",
		"./rule-ids": "./src/rule-ids.ts"
	},
	"files": [
		"README.ja.md",
		"bin",
		"dist",
		"src/rule-ids.ts"
	],
	"scripts": {
		"build": "bun build src/cli.ts src/scan.ts --target=bun --outdir=dist"
	},
	"keywords": [
		"comment",
		"lint",
		"suppression"
	],
	"devDependencies": {
		"@yuu1111/shared": "workspace:*"
	}
}
