{
	"name": "@yuu1111/tsdoc-check",
	"version": "2.0.3",
	"description": "Shared TSDoc syntax and contract checker",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/configs.git",
		"directory": "packages/engine/tsdoc-check"
	},
	"type": "module",
	"bin": {
		"tsdoc-check": "bin/cli.js"
	},
	"exports": {
		".": "./dist/scan.js"
	},
	"files": [
		"README.ja.md",
		"bin",
		"dist"
	],
	"scripts": {
		"build": "bun build src/cli.ts src/scan.ts --target=bun --outdir=dist --external @babel/parser --external @microsoft/tsdoc"
	},
	"keywords": [
		"tsdoc",
		"documentation",
		"lint"
	],
	"dependencies": {
		"@babel/parser": "^8.0.5",
		"@microsoft/tsdoc": "^0.16.0"
	},
	"devDependencies": {
		"@babel/types": "^8.0.5",
		"@yuu1111/shared": "workspace:*"
	}
}
