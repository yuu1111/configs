{
	"name": "configs",
	"private": true,
	"scripts": {
		"test": "bun test packages",
		"format": "biome check --write --unsafe .",
		"check": "biome check . && bun run comment-check && bun run tsdoc-check",
		"comment-check": "comment-check .",
		"tsdoc-check": "tsdoc-check .",
		"typecheck": "tsc --noEmit"
	},
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "^1.4.2",
		"@yuu1111/biome-config": "workspace:*",
		"@yuu1111/comment-check": "workspace:*",
		"@yuu1111/tsdoc-check": "workspace:*",
		"@yuu1111/tsconfig": "workspace:*",
		"typescript": "^7.0.2"
	}
}
