{
	"name": "configs",
	"private": true,
	"scripts": {
		"test": "bun test packages",
		"format": "biome check --write --unsafe .",
		"build": "bun run --filter '@yuu1111/quality-check' build",
		"check:quality": "bun run build && quality-check",
		"docs:dev": "vitepress dev",
		"docs:build": "vitepress build",
		"docs:preview": "vitepress preview"
	},
	"workspaces": [
		"packages/config/*",
		"packages/engine/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "^1.4.2",
		"@yuu1111/biome-config": "workspace:*",
		"@yuu1111/knip-config": "workspace:*",
		"@yuu1111/quality-check": "workspace:*",
		"@yuu1111/tsconfig": "workspace:*",
		"knip": "^6.35.1",
		"typescript": "^7.0.2",
		"vitepress": "^1.6.4"
	}
}
